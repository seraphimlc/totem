# Copy to .env (mode 600) and fill in. Never commit .env.

# OpenAI-compatible MaaS. Key stays on the server only.
MAAS_BASE=https://api.xytoken.xyb2b.com/v1
MAAS_KEY=

# Shared workbench account (v1 has a single login)
ACCESS_USERNAME=tutan
ACCESS_PASSWORD=

# Sign session cookies
SESSION_SECRET=

# Set to 1 behind HTTPS
SESSION_SECURE=0

# Bind address. Production unit uses 127.0.0.1
HOST=0.0.0.0
PORT=8780

# Optional: directory that contains project folders (used on the server).
# Locally, leave empty to use the paths in app/projects.json default_root.
CAD_DATA_DIR=

# --- DWG -> DXF (all optional) ------------------------------------------
# Leave everything commented out to auto-detect: ODA File Converter first,
# then dwg2dxf (LibreDWG). With neither installed, only DXF uploads work.
# auto | oda | dwg2dxf | none  (none = reject DWG uploads)
# CAD_DWG_CONVERTER=auto
# ODA File Converter executable. On Windows this is usually required, because
# ezdxf only looks at PATH otherwise:
# CAD_ODA_PATH=C:\Program Files\ODA\ODAFileConverter 26.4.0\ODAFileConverter.exe
# CAD_ODA_PATH=/opt/ODAFileConverter/ODAFileConverter
# CAD_ODA_TIMEOUT=180
# dwg2dxf executable. LibreDWG is GPLv3: install it on the host, never vendor it.
# CAD_DWG2DXF=/opt/cad-tools/prefix/bin/dwg2dxf
# CAD_DWG2DXF_TIMEOUT=180
# Scratch dir for conversion. Default: a .convert-tmp folder next to the output.
# CAD_DWG_CONVERT_TMPDIR=
# Total time for all DWG conversion attempts per upload (seconds).
# Keep it below the nginx proxy_read_timeout for /api/ (300s).
# CAD_DWG_CONVERT_BUDGET=270

# Optional overrides, absolute paths. Do not move the original folders.
# CAD_PROJECT_XUESHENGSHITANG=/workspace/cad-nl/projects/学生食堂
# CAD_PROJECT_WANSHANGCHENG=/workspace/cad-nl/demo-t53

# OpenRouter Jev (Decisions API) for off-topic routing. Key stays on the server only.
DECISION_API_KEY=
DECISION_BASE_URL=https://openrouter.ai/api/alpha/decisions
DECISION_MODEL=typesafe/jev-1.14
DECISION_API_PROTOCOL=openrouter-decisions
DECISION_REJECT_THRESHOLD=0.65
